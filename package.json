{
  "name": "trips",
  "type": "module",
  "version": "1.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "description": "Plan trips in your notes: create them from your templates and keep their dates, day plans and activities consistent.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LekoArts/obsidian-trips.git"
  },
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "demo-vault": "node scripts/create-demo-vault.ts",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint .",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "version-packages": "changeset version && node scripts/version.ts"
  },
  "dependencies": {
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "10.0.0",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@types/node": "^24.19.2",
    "esbuild": "0.28.2",
    "esbuild-svelte": "0.9.5",
    "eslint": "10.14.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "eslint-plugin-slop": "0.1.3",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "moment": "2.31.0",
    "obsidian": "1.14.4",
    "svelte-check": "4.7.7",
    "svelte-eslint-parser": "1.10.0",
    "svelte-preprocess": "6.0.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.0.5"
  }
}
